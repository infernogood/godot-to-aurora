# RPM spec template for a Godot game packaged for Aurora OS.
#
# Rendered by scripts/build_x86_64_rpm.sh. Substituted keys:
#   PKG_NAME, SUMMARY, VERSION, RELEASE, LICENSE, DESCRIPTION, CHANGELOG_DATE,
#   REQUIRES_EXCLUDE, LICENSE_FILES.
#
# The binary is patched with patchelf on the HOST before rpmbuild, so this spec
# intentionally has no BuildRequires: patchelf and no install-time scripts that
# need network access. The build container has no zypper/dnf and no network.
#
# distribution-specific dependencies are excluded because Aurora OS provides
# libxkbcommon and the Wayland/EGL stack itself; a private copy is bundled
# under the package data dir only as a compatibility fallback.
#
# NOTE: comments must not contain percent signs - rpm expands macros in them.

Name:           @PKG_NAME@
Summary:        @SUMMARY@
Version:        @VERSION@
Release:        @RELEASE@
License:        @LICENSE@

%define __provides_exclude_from ^%{_datadir}/%{name}/lib/.*\.so.*$
@REQUIRES_EXCLUDE@
%define debug_package %{nil}

%description
@DESCRIPTION@

%install
cp -a %{_topdir}/files/. %{buildroot}/

%files
%defattr(644,root,root,755)
%attr(755,root,root) %{_bindir}/%{name}
%{_datadir}/%{name}
%{_datadir}/applications/%{name}.desktop
%{_datadir}/icons/hicolor/*/apps/%{name}.png
@LICENSE_FILES@

%changelog
* @CHANGELOG_DATE@ godot-to-aurora <noreply@example.invalid> - @VERSION@-@RELEASE@
- Package rebuilt with godot-to-aurora.
