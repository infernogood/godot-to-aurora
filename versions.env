# godot-to-aurora — единый источник версий.
#
# Файл читается через `source` из scripts/lib/common.sh:
#   KEY=value, без export, без пробелов вокруг `=`.
# Если файл отсутствует, common.sh подставляет те же значения по умолчанию.

KIT_VERSION=1.1.0
GODOT_AURORA_TAG=4.7.2-auroraos1
GODOT_TEMPLATE_VERSION=4.7.2.stable
SDK_DEFAULT_VERSION=5.2.1.200
SDK_SUPPORTED_PREFIX=5.2.
SCONS_VERSION=4.11.1
SCONS_SHA256=454cef364348053422696e3d2ecb4fa593c96a624f955842eaaea64f95c8d11d
XKBCOMMON_VERSION=1.3.1
XKBCOMMON_SHA256=8eda6782c6ed4b83296521f2f7e6bea88aba76d49c39fb4fce0f8d355a9181ce
# Версии libxkbcommon, для которых подходит XKBCOMMON_SHA256. RPM в образе
# может сообщать packaging-суффикс (например, 1.3.1+git1) при том же ABI.
XKBCOMMON_KNOWN_VERSIONS="1.3.1 1.3.1+git1"
