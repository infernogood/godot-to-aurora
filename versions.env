# godot-to-aurora — единый источник версий.
#
# Файл читается через `source` из scripts/lib/common.sh:
#   KEY=value, без export, без пробелов вокруг `=`.
# Если файл отсутствует, common.sh подставляет те же значения по умолчанию.

KIT_VERSION=1.1.1
GODOT_AURORA_TAG=4.7.2-auroraos1
# Коммит, на который указывает GODOT_AURORA_TAG в форке savegame/godot.
GODOT_AURORA_SHA=17d8f3f283a00a1182da7b797edb85eacd831091
GODOT_TEMPLATE_VERSION=4.7.2.stable
SDK_DEFAULT_VERSION=5.2.1.200
SDK_SUPPORTED_PREFIX=5.2.
SCONS_VERSION=4.11.1
SCONS_SHA256=454cef364348053422696e3d2ecb4fa593c96a624f955842eaaea64f95c8d11d
XKBCOMMON_VERSION=1.3.1
# Официальный архив https://xkbcommon.org/download/libxkbcommon-1.3.1.tar.xz
# (зеркало distfiles.gentoo.org отдаёт те же байты).
XKBCOMMON_SHA256=b3c710d27a2630054e1e1399c85b7f330ef03359b460f0c1b3b587fd01fe9234
# Версии libxkbcommon, для которых подходит XKBCOMMON_SHA256. RPM в образе
# может сообщать packaging-суффикс (например, 1.3.1+git1) при том же ABI.
XKBCOMMON_KNOWN_VERSIONS="1.3.1 1.3.1+git1"

# Известные SHA-256 релизных бинарников (второй якорь поверх SHA256SUMS).
# Пустое значение = проверка по этому якорю пропускается.
EDITOR_SHA256=28299973ea042a82b42dcdecac6a8c3d1c50c465924bf638306f1d42ac947633
X64_TEMPLATE_SHA256=95b1fd82768d055005163b27d4756fcea4a30323e3dab48ad6301e07654c7490
ARM64_RELEASE_SHA256=4804de5937fdb33a512e805edb1f5aeb3aa128c6e1dff185e19a8f3b2c45e89e
ARM64_DEBUG_SHA256=f9e1606aa48ae5818a69184439a1a099ab736757665d38d6e5d81a98a7f58391
